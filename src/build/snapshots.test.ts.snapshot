exports[`snapshots > otvet theme > should match pixelify theme snapshot 1`] = `
{
  "themeName": "otvet",
  "fontFamilyFallbacks": "apple-system, system-ui, \\"Helvetica Neue\\", Arial, sans-serif",
  "fontFamilyAccent": "VKSansDisplay, Helvetica, Arial, sans-serif",
  "fontFamilyBase": "Arial, sans-serif",
  "fontWeightAccent1": 500,
  "fontWeightAccent2": 500,
  "fontWeightAccent3": 400,
