      "fontWeight": "var(--vkui--font_display_title3--font_weight--regular, 500)"
    }
  },
  "fontDisplayTitle4": {
    "regular": {
      "fontSize": "var(--vkui--font_display_title4--font_size--regular, 17px)",
      "lineHeight": "var(--vkui--font_display_title4--line_height--regular, 24px)",
