exports[`snapshots > search theme > should match pixelify theme snapshot 1`] = `
{
  "themeName": "search",
  "fontFamilyFallbacks": "apple-system, system-ui, \\"Helvetica Neue\\", Arial, sans-serif",
  "fontFamilyAccent": "VKSansDisplay, MailSans, apple-system, system-ui, \\"Helvetica Neue\\", Arial, sans-serif",
  "fontFamilyBase": "Arial, sans-serif",
  "fontWeightAccent1": 500,
  "fontWeightAccent2": 500,
  "fontWeightAccent3": 400,
  "fontWeightBase1": 700,
  "fontWeightBase2": 700,
  "fontWeightBase3": 400,
  "fontDisplayTitle1": {
    "regular": {
      "fontSize": "23px",
      "lineHeight": "28px",
      "fontFamily": "VKSansDisplay, MailSans, apple-system, system-ui, \\"Helvetica Neue\\", Arial, sans-serif",
      "fontWeight": 500
    }
  },
  "fontDisplayTitle2": {
    "regular": {
