exports[`snapshots > cloud theme > should match pseudo theme from CssVars 1`] = `
{
  "themeName": "var(--vkui--theme_name, cloud)",
  "fontFamilyFallbacks": "var(--vkui--font_family_fallbacks, apple-system, system-ui, \\"Helvetica Neue\\", Arial, sans-serif)",
  "fontFamilyAccent": "var(--vkui--font_family_accent, VKSansDisplay, MailSans, apple-system, system-ui, \\"Helvetica Neue\\", Arial, sans-serif)",
  "fontFamilyBase": "var(--vkui--font_family_base, Inter, Helvetica, Arial, sans-serif)",
  "fontWeightAccent1": "var(--vkui--font_weight_accent1, 500)",
  "fontWeightAccent2": "var(--vkui--font_weight_accent2, 500)",
  "fontWeightAccent3": "var(--vkui--font_weight_accent3, 400)",
  "fontWeightBase1": "var(--vkui--font_weight_base1, 700)",
  "fontWeightBase2": "var(--vkui--font_weight_base2, 700)",
  "fontWeightBase3": "var(--vkui--font_weight_base3, 400)",
  "fontDisplayTitle1": {
    "regular": {
      "fontSize": "var(--vkui--font_display_title1--font_size--regular, 23px)",
      "lineHeight": "var(--vkui--font_display_title1--line_height--regular, 28px)",
      "fontFamily": "var(--vkui--font_display_title1--font_family--regular, VKSansDisplay, MailSans, apple-system, system-ui, \\"Helvetica Neue\\", Arial, sans-serif)",
      "fontWeight": "var(--vkui--font_display_title1--font_weight--regular, 500)"
    }
  },
  "fontDisplayTitle2": {
    "regular": {
      "fontSize": "var(--vkui--font_display_title2--font_size--regular, 21px)",
      "lineHeight": "var(--vkui--font_display_title2--line_height--regular, 26px)",
      "fontFamily": "var(--vkui--font_display_title2--font_family--regular, VKSansDisplay, MailSans, apple-system, system-ui, \\"Helvetica Neue\\", Arial, sans-serif)",
      "fontWeight": "var(--vkui--font_display_title2--font_weight--regular, 500)"
    },
    "compact": {
      "fontSize": "var(--vkui--font_display_title2--font_size--compact, 22px)",
      "lineHeight": "var(--vkui--font_display_title2--line_height--compact, 22px)",
      "fontFamily": "var(--vkui--font_display_title2--font_family--compact, VKSansDisplay, MailSans, apple-system, system-ui, \\"Helvetica Neue\\", Arial, sans-serif)",
      "fontWeight": "var(--vkui--font_display_title2--font_weight--compact, 500)"
    }
  },
  "fontDisplayTitle3": {
    "regular": {
      "fontSize": "var(--vkui--font_display_title3--font_size--regular, 19px)",
      "lineHeight": "var(--vkui--font_display_title3--line_height--regular, 24px)",
      "fontFamily": "var(--vkui--font_display_title3--font_family--regular, VKSansDisplay, MailSans, apple-system, system-ui, \\"Helvetica Neue\\", Arial, sans-serif)",
      "fontWeight": "var(--vkui--font_display_title3--font_weight--regular, 500)"
    }
  },
  "fontDisplayTitle4": {
    "regular": {
