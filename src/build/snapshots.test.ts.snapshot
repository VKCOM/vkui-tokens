exports[`snapshots > calendarDark theme > should match cssVars snapshot 1`] = `
{
  "themeName": {
    "name": "--vkui--theme_name",
    "value": "var(--vkui--theme_name, calendarDark)"
  },
  "fontFamilyFallbacks": {
    "name": "--vkui--font_family_fallbacks",
    "value": "var(--vkui--font_family_fallbacks, apple-system, system-ui, \\"Helvetica Neue\\", Arial, sans-serif)"
  },
  "fontFamilyAccent": {
    "name": "--vkui--font_family_accent",
    "value": "var(--vkui--font_family_accent, VKSansDisplay, MailSans, Helvetica, Arial, sans-serif)"
  },
  "fontFamilyBase": {
    "name": "--vkui--font_family_base",
    "value": "var(--vkui--font_family_base, VKSansDisplay, MailSans, Helvetica, Arial, sans-serif)"
