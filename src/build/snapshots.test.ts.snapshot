exports[`snapshots > calendarDark theme > should match root theme snapshot 1`] = `
{
  "themeName": "calendarDark",
  "fontFamilyFallbacks": "apple-system, system-ui, \\"Helvetica Neue\\", Arial, sans-serif",
  "fontFamilyAccent": "VKSansDisplay, MailSans, Helvetica, Arial, sans-serif",
  "fontFamilyBase": "VKSansDisplay, MailSans, Helvetica, Arial, sans-serif",
  "fontWeightAccent1": 500,
  "fontWeightAccent2": 500,
