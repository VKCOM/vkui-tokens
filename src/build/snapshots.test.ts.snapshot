  "widthFromDesktopS": "var(--vkui--width_from_desktop_s, \\"(min-width: 768px)\\")",
  "widthDesktopS": "var(--vkui--width_desktop_s, \\"(min-width: 768px)\\")",
  "themeType": "pixelify"
}
`;

