exports[`snapshots > octaviusVK theme > should match pixelify theme snapshot 1`] = `
{
  "themeName": "octaviusVK",
  "fontFamilyFallbacks": "apple-system, system-ui, \\"Helvetica Neue\\", Arial, sans-serif",
  "fontFamilyAccent": "VKSansDisplay, Helvetica, Arial, sans-serif",
  "fontFamilyBase": "VKSansText, Helvetica, Arial, sans-serif",
  "fontWeightAccent1": 500,
  "fontWeightAccent2": 500,
  "fontWeightAccent3": 400,
  "fontWeightBase1": 700,
  "fontWeightBase2": 700,
  "fontWeightBase3": 400,
  "fontDisplayTitle1": {
