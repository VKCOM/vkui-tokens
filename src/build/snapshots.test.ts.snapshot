exports[`snapshots > legoSimpleAndroidDark theme > should match pseudo theme from CssVars 1`] = `
{
  "themeName": "var(--vkui--theme_name, legoSimpleAndroidDark)",
  "themeNameBase": "var(--vkui--theme_name_base, legoSimpleAndroid)",
  "elevation1": "var(--vkui--elevation1, 0px 0px 2px rgba(0, 0, 0, 0.03), 0px 2px 2px rgba(0, 0, 0, 0.06))",
  "elevation1InvertY": "var(--vkui--elevation1_invert_y, 0px 0px 2px rgba(0, 0, 0, 0.03), 0px -2px 2px rgba(0, 0, 0, 0.06))",
  "elevation2": "var(--vkui--elevation2, 0px 4px 8px rgba(0, 0, 0, 0.04), 0px 0px 4px rgba(0, 0, 0, 0.06))",
  "elevation3": "var(--vkui--elevation3, 0px 0px 2px rgba(0, 0, 0, 0.08), 0px 4px 16px rgba(0, 0, 0, 0.08))",
  "elevation4": "var(--vkui--elevation4, 0px 0px 8px rgba(0, 0, 0, 0.12), 0px 16px 16px rgba(0, 0, 0, 0.16))",
  "blurS": "var(--vkui--blur_s, 8px)",
  "blurM": "var(--vkui--blur_m, 16px)",
  "blurL": "var(--vkui--blur_l, 32px)",
  "blurXL": "var(--vkui--blur_x_l, 64px)",
  "fontFamilyFallbacks": "var(--vkui--font_family_fallbacks, -apple-system, system-ui, \\"Helvetica Neue\\", Roboto, sans-serif)",
  "fontFamilyAccent": "var(--vkui--font_family_accent, -apple-system, system-ui, \\"Helvetica Neue\\", Roboto, sans-serif)",
  "fontFamilyBase": "var(--vkui--font_family_base, -apple-system, system-ui, \\"Helvetica Neue\\", Roboto, sans-serif)",
  "fontWeightAccent1": "var(--vkui--font_weight_accent1, 600)",
  "fontWeightAccent2": "var(--vkui--font_weight_accent2, 500)",
  "fontWeightAccent3": "var(--vkui--font_weight_accent3, 400)",
  "fontWeightBase1": "var(--vkui--font_weight_base1, 600)",
  "fontWeightBase2": "var(--vkui--font_weight_base2, 500)",
  "fontWeightBase3": "var(--vkui--font_weight_base3, 400)",
  "fontDisplayTitle1": {
    "regular": {
      "fontSize": "var(--vkui--font_display_title1--font_size--regular, 23px)",
      "lineHeight": "var(--vkui--font_display_title1--line_height--regular, 28px)",
      "fontFamily": "var(--vkui--font_display_title1--font_family--regular, -apple-system, system-ui, \\"Helvetica Neue\\", Roboto, sans-serif)",
      "fontWeight": "var(--vkui--font_display_title1--font_weight--regular, 600)"
    }
  },
  "fontDisplayTitle2": {
    "regular": {
      "fontSize": "var(--vkui--font_display_title2--font_size--regular, 21px)",
      "lineHeight": "var(--vkui--font_display_title2--line_height--regular, 26px)",
      "fontFamily": "var(--vkui--font_display_title2--font_family--regular, -apple-system, system-ui, \\"Helvetica Neue\\", Roboto, sans-serif)",
      "fontWeight": "var(--vkui--font_display_title2--font_weight--regular, 600)"
    },
    "compact": {
      "fontSize": "var(--vkui--font_display_title2--font_size--compact, 22px)",
      "lineHeight": "var(--vkui--font_display_title2--line_height--compact, 24px)",
