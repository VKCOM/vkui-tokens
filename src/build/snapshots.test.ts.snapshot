exports[`snapshots > octaviusVKDark theme > should match pseudo theme from CssVars 1`] = `
{
  "themeName": "var(--vkui--theme_name, octaviusVKDark)",
  "fontFamilyFallbacks": "var(--vkui--font_family_fallbacks, apple-system, system-ui, \\"Helvetica Neue\\", Arial, sans-serif)",
  "fontFamilyAccent": "var(--vkui--font_family_accent, VKSansDisplay, Helvetica, Arial, sans-serif)",
  "fontFamilyBase": "var(--vkui--font_family_base, VKSansText, Helvetica, Arial, sans-serif)",
  "fontWeightAccent1": "var(--vkui--font_weight_accent1, 500)",
  "fontWeightAccent2": "var(--vkui--font_weight_accent2, 500)",
  "fontWeightAccent3": "var(--vkui--font_weight_accent3, 400)",
  "fontWeightBase1": "var(--vkui--font_weight_base1, 700)",
  "fontWeightBase2": "var(--vkui--font_weight_base2, 700)",
  "fontWeightBase3": "var(--vkui--font_weight_base3, 400)",
