exports[`snapshots > vkontakteIOSDark theme > should match pseudo theme from CssVars 1`] = `
{
  "themeName": "var(--vkui--theme_name, vkontakteIOSDark)",
  "themeNameBase": "var(--vkui--theme_name_base, vkontakteIOS)",
  "gradientBlack": "var(--vkui--gradient_black, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.02) 15%, rgba(0, 0, 0, 0.08) 30%, rgba(0, 0, 0, 0.32) 70%, rgba(0, 0, 0, 0.38) 85%, rgba(0, 0, 0, 0.4) 100%)",
  "gradientWhite": "var(--vkui--gradient_white, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.05) 15%, rgba(255, 255, 255, 0.2) 30%, rgba(255, 255, 255, 0.8) 70%, rgba(255, 255, 255, 0.95) 85%, rgba(255, 255, 255, 1) 100%)",
  "gradientTint": "var(--vkui--gradient_tint, rgba(32, 32, 33, 0) 0%, rgba(32, 32, 33, 0.05) 15%, rgba(32, 32, 33, 0.2) 30%, rgba(32, 32, 33, 0.8) 70%, rgba(32, 32, 33, 0.95) 85%, rgba(32, 32, 33, 1) 100%)",
  "gradient": "var(--vkui--gradient, rgba(25, 25, 26, 0) 0%, rgba(25, 25, 26, 0.05) 15%, rgba(25, 25, 26, 0.2) 30%, rgba(25, 25, 26, 0.8) 70%, rgba(25, 25, 26, 0.95) 85%, rgba(25, 25, 26, 1) 100%)",
  "elevation1": "var(--vkui--elevation1, 0px 0px 2px 0px rgba(0, 0, 0, 0.10), 0px 2px 2px 0px rgba(0, 0, 0, 0.20))",
  "elevation1InvertY": "var(--vkui--elevation1_invert_y, 0px 0px 2px 0px rgba(0, 0, 0, 0.10), 0px -2px 2px 0px rgba(0, 0, 0, 0.20))",
  "elevation2": "var(--vkui--elevation2, 0px 4px 8px 0px rgba(0, 0, 0, 0.15), 0px 0px 4px 0px rgba(0, 0, 0, 0.20))",
  "elevation3": "var(--vkui--elevation3, 0px 0px 2px 0px rgba(0, 0, 0, 0.30), 0px 4px 16px 0px rgba(0, 0, 0, 0.30))",
  "elevation4": "var(--vkui--elevation4, 0px 0px 8px 0px rgba(0, 0, 0, 0.10), 0px 16px 16px 0px rgba(0, 0, 0, 0.20))",
  "blurS": "var(--vkui--blur_s, 8px)",
  "blurM": "var(--vkui--blur_m, 16px)",
  "blurL": "var(--vkui--blur_l, 32px)",
  "blurXL": "var(--vkui--blur_x_l, 64px)",
  "fontFamilyFallbacks": "var(--vkui--font_family_fallbacks, -apple-system, system-ui, \\"Helvetica Neue\\", Roboto, sans-serif)",
  "fontFamilyAccent": "var(--vkui--font_family_accent, \\"VK Sans Display\\", -apple-system, system-ui, \\"Helvetica Neue\\", Roboto, sans-serif)",
  "fontFamilyBase": "var(--vkui--font_family_base, -apple-system, system-ui, \\"Helvetica Neue\\", Roboto, sans-serif)",
  "fontWeightAccent1": "var(--vkui--font_weight_accent1, 600)",
  "fontWeightAccent2": "var(--vkui--font_weight_accent2, 500)",
  "fontWeightAccent3": "var(--vkui--font_weight_accent3, 400)",
  "fontWeightBase1": "var(--vkui--font_weight_base1, 600)",
  "fontWeightBase2": "var(--vkui--font_weight_base2, 500)",
  "fontWeightBase3": "var(--vkui--font_weight_base3, 400)",
