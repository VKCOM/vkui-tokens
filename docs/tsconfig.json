{
  "compilerOptions": {
    "strict": false,
    "target": "ES2019",
    "jsx": "react",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "removeComments": false,
    "allowSyntheticDefaultImports": true,
    "noUncheckedSideEffectImports": false,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "lib": ["ES2019", "DOM"],
    "types": ["*"],
    "declaration": true,
    "resolveJsonModule": true,
    "paths": {
      "*": ["./*"]
    }
  }
}
